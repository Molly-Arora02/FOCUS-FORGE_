# ==========================================
# FOCUS FORGE - ENVIRONMENT CONFIGURATION
# ==========================================

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode Override (Set to false when live Supabase / MongoDB are connected)
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------
# Real Email OTP Dispatch (Choose Resend or SMTP)
# ------------------------------------------
# Option A: Resend API (https://resend.com - Free instant API key)
RESEND_API_KEY=

# Option B: Standard SMTP (e.g. Gmail App Password, Brevo, Sendgrid, Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Focus Forge <noreply@focusforge.io>"

# ------------------------------------------
# Real Phone SMS OTP Dispatch (Choose Twilio or Fast2SMS)
# ------------------------------------------
# Option A: Twilio SMS (https://twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option B: Fast2SMS (https://fast2sms.com - Instant Indian +91 SMS API)
FAST2SMS_API_KEY=

# ------------------------------------------
# Supabase Auth (Client & Server)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# MongoDB Database (Atlas or Local)
# ------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/focusforge?retryWrites=true&w=majority
MONGODB_DB_NAME=focusforge

# ------------------------------------------
# AI Provider Configuration (Options: "gemini" | "openai" | "claude" | "ollama" | "mock")
# ------------------------------------------
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-or-openai-api-key
AI_MODEL=gemini-1.5-flash

# ------------------------------------------
# Google Cloud OAuth & Drive API
# ------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback

# ------------------------------------------
# Voice / Realtime AI (Optional)
# ------------------------------------------
ELEVENLABS_API_KEY=your-elevenlabs-key
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-cert
